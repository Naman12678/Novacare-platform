NODE_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_SESSION_TOKEN=your_session_token
AWS_ENDPOINT_URL=http://localhost:4566

# DynamoDB
DYNAMODB_TABLE_NAME=novacare_patient_state

# PostgreSQL
DATABASE_URL=postgresql://novacare:novacare_secret@localhost:5432/novacare_db

# Redis
REDIS_URL=redis://localhost:6379

# Python Agent Service
AGENT_SERVICE_URL=http://localhost:8100

# WhatsApp Business API
WHATSAPP_API_URL=https://graph.facebook.com/v25.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_VERIFY_TOKEN=novacare-webhook-verify-2026

# Exotel IVR
EXOTEL_API_KEY=your_api_key
EXOTEL_API_TOKEN=your_api_token
EXOTEL_SID=your_sid
EXOTEL_CALLER_ID=your_caller_id
EXOTEL_APP_ID=your_app_id

# ABDM
ABDM_BASE_URL=https://dev.abdm.gov.in
ABDM_CLIENT_ID=your_client_id
ABDM_CLIENT_SECRET=your_secret
ABDM_HIP_ID=novacare-hip-001

# JWT
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=24h

# SageMaker
SAGEMAKER_ENDPOINT_NAME=novacare-risk-model
