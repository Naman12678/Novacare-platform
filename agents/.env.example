# ============================================================
# NovaCare v2.0 — Agent Service Environment Variables
# Copy to .env and fill in your values
# ============================================================

# App
APP_ENV=development
LOG_LEVEL=INFO

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

# Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_NOVA_MODEL_ID=amazon.nova-micro-v1:0

# DynamoDB
DYNAMODB_TABLE_NAME=novacare_patient_state
DYNAMODB_ENDPOINT_URL=http://localhost:4566

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://novacare:novacare_secret@localhost:5432/novacare_db

# Redis
REDIS_URL=redis://localhost:6379

# SageMaker
SAGEMAKER_ENDPOINT_NAME=novacare-risk-model
